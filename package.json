{
  "name": "rigidez-app",
  "version": "1.0.0",
  "description": "Análisis matricial de vigas, pórticos y cerchas para estudiantes de ingeniería civil",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:single": "node tools/build-single.js",
    "android:add": "cap add android",
